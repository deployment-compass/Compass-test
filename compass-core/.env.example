# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Model to use. Use haiku for cheap dev iteration, sonnet for final quality.
CLAUDE_MODEL=claude-haiku-4-5

# Prometheus / Loki endpoints (defaults match the kind cluster port-forward setup)
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100

# Kubernetes namespace the demo app lives in
K8S_NAMESPACE=default
DEMO_APP_NAME=demo-app

# Decision thresholds
ROLLBACK_CONFIDENCE_THRESHOLD=75
HUMAN_REVIEW_CONFIDENCE_THRESHOLD=40
ERROR_RATE_HARD_THRESHOLD=0.05

# Local DB
DATABASE_URL=sqlite:///./selfops.db

# Auto-fix / hotfix PR flow — OFF by default, and should stay off unless
# you've deliberately decided to demo it. See core/app/fix_generator.py
# for exactly what it does and doesn't do.
ENABLE_AUTO_FIX=false
GITHUB_TOKEN=
GITHUB_REPO=your-username/selfops
AUTO_FIX_TARGET_FILE=infra/demo-app/app/main.py
AUTO_FIX_MIN_CONFIDENCE=85
