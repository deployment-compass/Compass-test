{
  "title": "compass — demo-app",
  "uid": "compass-demo-app",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (by status)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{app=\"demo-app\"}[1m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate (%) — this is what Layer 1 checks",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "100 * sum(rate(http_requests_total{app=\"demo-app\",status=~\"5..\"}[2m])) / sum(rate(http_requests_total{app=\"demo-app\"}[2m]))",
          "legendFormat": "error %"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 latency (seconds) — this is what Layer 2 compares against baseline",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{app=\"demo-app\"}[2m])) by (le))",
          "legendFormat": "p95 latency"
        }
      ]
    },
    {
      "id": 4,
      "title": "Recent error logs (from Loki) — this is what Layer 3 reads",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "{app=\"demo-app\"} |= \"error\"" }
      ]
    }
  ]
}
